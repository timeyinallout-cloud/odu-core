{
  "name": "odu-core",
  "version": "1.0.0",
  "description": "The 256 Odù Ifá as a canonical byte mapping, with Yorùbá orthography intact.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "keywords": [
    "odu",
    "ifa",
    "yoruba",
    "binary",
    "heritage-computing",
    "encoding"
  ],
  "license": "MIT",
  "scripts": {
    "build": "../node_modules/.bin/tsc && node scripts/fix-decl-extensions.mjs",
    "test": "node --test \"test/*.test.js\"",
    "check": "../node_modules/.bin/tsc --noEmit",
    "prepack": "node scripts/copy-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timeyinallout-cloud/odu-core.git"
  }
}
